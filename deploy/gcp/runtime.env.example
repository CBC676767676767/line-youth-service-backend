# Template only. Use init_env.py on the VM, then sudoedit its private output.
# Do not put this runtime file in the source archive or print resolved Compose config.
YOUTH_DOMAIN=
YOUTH_APP_ENV=production
YOUTH_PUBLIC_ORIGIN=
YOUTH_ALLOWED_ORIGINS=[]
YOUTH_COOKIE_SECURE=true
YOUTH_AUTO_CREATE_SCHEMA=false
POSTGRES_PASSWORD=
YOUTH_DATABASE_URL=
YOUTH_SECRET_KEY=
YOUTH_TOTP_ENCRYPTION_KEY=
YOUTH_STORAGE_DIR=/data/files
YOUTH_MAIL_SPOOL_DIR=/data/mail
YOUTH_MAIL_BACKEND=smtp
YOUTH_SMTP_HOST=
YOUTH_SMTP_PORT=587
YOUTH_SMTP_USERNAME=
YOUTH_SMTP_PASSWORD=
YOUTH_SMTP_STARTTLS=true
YOUTH_SMTP_USE_TLS=false
YOUTH_MAIL_FROM=
YOUTH_SCAN_BACKEND=clamav
YOUTH_CLAMAV_HOST=clamav
YOUTH_CLAMAV_PORT=3310
YOUTH_WORKER_POLL_SECONDS=0.5
YOUTH_PRECHECK_DEMO_ENABLED=false
YOUTH_LINE_SIMULATOR_ENABLED=false
YOUTH_LINE_BOT_ENABLED=false
YOUTH_LINE_REPLY_MODE=disabled
YOUTH_LINE_PUBLIC_PRECHECK_URL=
YOUTH_LINE_MESSAGING_CHANNEL_ID=
YOUTH_LINE_CHANNEL_SECRET=
YOUTH_LINE_CHANNEL_ACCESS_TOKEN=
YOUTH_LINE_DESTINATION_USER_ID=
# LINE Login/LIFF is separate from bot replies. Blank means it is not configured.
YOUTH_LINE_CHANNEL_ID=
YOUTH_LINE_PROVIDER_ID=
VITE_LIFF_ID=
VITE_LINE_BOT_BASIC_ID=@057acdtt
VITE_LINE_BOT_DISPLAY_NAME=meichu_test
# Both this flag and the notifications Compose profile must be enabled explicitly.
YOUTH_ENABLE_CASE_NOTIFICATIONS=false
POSTGRES_IMAGE=postgres:17-alpine
CLAMAV_IMAGE=clamav/clamav:stable
CADDY_IMAGE=caddy:2-alpine
