# Copying this template alone is not sufficient: generate unique secrets.
# Recommended: python -m app.cli init creates a private, fully usable .env.
YOUTH_APP_ENV=development
YOUTH_PUBLIC_ORIGIN=http://127.0.0.1:8000
YOUTH_ALLOWED_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]
YOUTH_COOKIE_SECURE=false
YOUTH_MAIL_BACKEND=spool
YOUTH_SCAN_BACKEND=development
# YOUTH_DATABASE_URL: generated by app.cli init
# YOUTH_SECRET_KEY: generated by app.cli init
# YOUTH_TOTP_ENCRYPTION_KEY: generated by app.cli init; back it up securely
# POSTGRES_PASSWORD: generated by app.cli init
# LINE Login and Messaging API channels must belong to the same provider.
YOUTH_LINE_CHANNEL_ID=
YOUTH_LINE_PROVIDER_ID=
YOUTH_LINE_MESSAGING_CHANNEL_ID=
YOUTH_LINE_CHANNEL_SECRET=
YOUTH_LINE_CHANNEL_ACCESS_TOKEN=
YOUTH_LINE_DESTINATION_USER_ID=
# To enable real delivery/scanning configure these and switch the backends.
YOUTH_SMTP_HOST=
YOUTH_SMTP_PORT=587
YOUTH_SMTP_USERNAME=
YOUTH_SMTP_PASSWORD=
YOUTH_SMTP_STARTTLS=true
YOUTH_SMTP_USE_TLS=false
YOUTH_CLAMAV_HOST=127.0.0.1
YOUTH_CLAMAV_PORT=3310
