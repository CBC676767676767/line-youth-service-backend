      "base_documents": [
        {
          "doc_id": "D01",
          "title": "身分證正反面",
          "reason": "正式申辦應能辨識申請人資訊及設籍地址；自述與清晰照片均不代表已查證現行戶籍或文件真實。預檢不收證件。"
        },
        {
          "doc_id": "D04",
          "title": "申請人本人存摺封面",
          "reason": "補助款須匯入申請人本人帳戶；父母、配偶或其他人代付不代表可用代付人帳戶領款。預檢不收銀行帳號。"
        },
        {
          "doc_id": "D05",
          "title": "申請人親筆簽名切結書",
          "reason": "依官方範本準備及親筆簽名；勾選已準備僅為自述，不代表已收件或查證簽名。"
        }
      ],
      "purchased_documents": [
        {
          "doc_id": "D02",
          "title": "官方訂閱收據／憑證",
          "reason": "須核對訂閱人姓名或可識別電子信箱、完整AI工具名稱、軟體公司、訂閱日期、訂閱期間或續訂日、原始費用與付款方式；尚未核對內容。"
        },
        {
          "doc_id": "D03",
          "title": "臺幣帳單／換算及繳款佐證",
          "reason": "以實際臺幣帳單為基礎並提供相應繳款證明；外幣收據不能以當日匯率自行換成正式核銷金額。逐月交易應逐月準備。"
        }
      ],
      "paid_by_other_documents": [
        {
          "doc_id": "D07_joint",
          "title": "申請人與代付人共同切結書",
          "reason": "依官方範本由申請人與父母、配偶或法定代理人親筆共同簽署；適用關係範圍仍需承辦確認，不代表已核准。"
        },
        {
          "doc_id": "D07_relationship",
          "title": "申請人與代付人的身分關係證明",
          "reason": "準備足以證明親屬或法定代理關係的文件，內容尚未核對；不自行擴充成任何朋友代付都可適用。"
        }
      ],
