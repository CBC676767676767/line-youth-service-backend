  "pending_confirmations": [
    {
      "id": "PC01",
      "title": "月費累積與跨月",
      "detail": "釐清連續月份累積與訂閱期間不得跨月文字如何同時適用；目前支援逐月備件，累積情境轉人工。",
      "rule_ids": [
        "R10"
      ]
    },
    {
      "id": "PC02",
      "title": "申請期限起算",
      "detail": "購買後一或兩個月的正式起算、月末與休假日處理待確認；不能替換成30或60日或延後年度截止。",
      "rule_ids": [
        "R08",
        "R09"
      ]
    },
    {
      "id": "PC03",
      "title": "代付關係及證明",
      "detail": "主文法定代理人與審核段落父母、配偶、法定代理人範圍不一致，具體關係及證明要求待確認。",
      "rule_ids": [
        "D07"
      ]
    },
    {
      "id": "PC04",
      "title": "非信用卡付款",
      "detail": "申辦欄位列信用卡末四碼與姓名照片；非信用卡付款替代佐證待承辦確認，預檢不自行豁免。",
      "rule_ids": [
        "D03"
      ]
    },
    {
      "id": "PC05",
      "title": "語言認證適用",
      "detail": "公告列三類本土語言認證，但適用證照細目、級別及期限未確認；不自行增加門檻。",
      "rule_ids": [
        "R05",
        "D06"
      ]
    },
    {
      "id": "PC06",
      "title": "金額認列及捨入",
      "detail": "小數捨入、手續費、混合品項、額度加購拆分及年費費用認列待確認；僅提供Decimal條件式試算。",
      "rule_ids": [
        "R06",
        "R14"
      ]
    },
    {
      "id": "PC07",
      "title": "一次購買與多工具",
      "detail": "一案多工具、月費累積與每年一次及一次AI工具購買限制如何共同適用待確認。",
      "rule_ids": [
        "R10",
        "R11"
      ]
    },
    {
      "id": "PC08",
      "title": "未列工具及通路例外",
      "detail": "未知工具、未知方案及App Store、Google Play等非官網通路例外待確認；列名不是所有方案白名單。",
      "rule_ids": [
        "R12",
        "R13"
      ]
    },
    {
      "id": "PC09",
      "title": "預算及跨機關資料",
      "detail": "無即時額度或跨機關補助資料，不能宣稱保留名額、仍有預算或已排除重複補助。",
      "rule_ids": [
        "R08",
        "R11"
      ]
    },
    {
      "id": "PC10",
      "title": "正式補件期限",
      "detail": "須有效機關通知與政府辦公日曆，不能以預檢修正任務設定正式10工作天倒數或自動行政處分。",
      "rule_ids": [
        "R09"
      ]
    }
  ]
}
